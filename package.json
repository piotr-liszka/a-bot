{
  "name": "a-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source desktop client for chatting with AI bots (Claude Code, Codex, Ollama) running inside a shared Linux container on your own device.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "agent",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && npm run dev -w @a-bot/desktop",
    "build": "npm run box:pack && npm run build -w @a-bot/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,storage-api,mailpit,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "box:pack": "node scripts/pack-box.mjs",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-deps.mjs --stamp"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "supabase": "^2.122.0"
  },
  "engines": {
    "node": ">=20"
  }
}
