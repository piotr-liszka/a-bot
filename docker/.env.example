# Written by the desktop app when it installs a worker. To run the sandbox by hand:
#   npm run box:pack && cp docker/.env.example dist/box/.env  (fill it in)
#   cd dist/box && docker compose -p a-bot up -d --build
A_BOT_SUPABASE_URL=https://your-project.supabase.co
A_BOT_SUPABASE_ANON_KEY=your-publishable-or-anon-key
A_BOT_DEVICE_NAME=Mój serwer
A_BOT_WORKSPACE_DIR=./workspace
