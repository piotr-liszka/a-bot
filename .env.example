# Backend the app and the agent share. Hosted: the URL and publishable key of the
# a-bot Supabase project. Self-hosted: your own Supabase (see docs/self-hosting.md).
A_BOT_SUPABASE_URL=https://your-project.supabase.co
A_BOT_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Name shown in the app and the host folder mounted at /workspace.
A_BOT_DEVICE_NAME=Mój serwer
A_BOT_WORKSPACE_DIR=./workspace
