#!/usr/bin/env node
// Stand-in for the Claude Code CLI used in tests and demos: replays a short stream-json session.
const args = process.argv.slice(2);
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

if (args[0] === '--version') {
  console.log('2.1.0 (Claude Code)');
  process.exit(0);
}
if (args[0] === 'auth' && args[1] === 'status') {
  console.log(JSON.stringify({ loggedIn: true, authMethod: 'claude.ai' }));
  process.exit(0);
}
const prompt = args[args.indexOf('-p') + 1] ?? '';
const instructions = args.includes('--append-system-prompt') ? args[args.indexOf('--append-system-prompt') + 1] : '';
const words = (text) => text.split(/(?<= )/);

const mcpConfig = args.includes('--mcp-config') ? JSON.parse(args[args.indexOf('--mcp-config') + 1]) : undefined;

/** Plays a short answer without tools. */
function reply(text) {
  out({ type: 'system', subtype: 'init', session_id: 'fake-session-1', model: 'sonnet' });
  out({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text } } });
  out({ type: 'result', subtype: 'success', is_error: false, result: text, session_id: 'fake-session-1' });
}

/** Calls a tool of the a-bot MCP server the agent configured, like Claude Code would. */
function callMcpTool(name, args) {
  const { spawn } = process.getBuiltinModule('node:child_process');
  const server = mcpConfig.mcpServers['a-bot'];
  const child = spawn(server.command, server.args, { env: { ...process.env, ...server.env }, stdio: ['pipe', 'pipe', 'inherit'] });
  const send = (m) => child.stdin.write(JSON.stringify({ jsonrpc: '2.0', ...m }) + '\n');
  return new Promise((resolve, reject) => {
    let buf = '';
    child.stdout.on('data', (d) => {
      buf += d;
      for (const line of buf.split('\n').slice(0, -1)) {
        const msg = JSON.parse(line);
        if (msg.id === 1) send({ id: 2, method: 'tools/call', params: { name, arguments: args } });
        if (msg.id === 2) {
          child.kill();
          resolve(msg.result.content[0].text);
        }
      }
      buf = buf.slice(buf.lastIndexOf('\n') + 1);
    });
    child.on('error', reject);
    child.on('exit', (code) => reject(new Error(`a-bot MCP server exited with ${code}`)));
    send({ id: 1, method: 'initialize', params: { protocolVersion: '2025-06-18' } });
  });
}

(async () => {
  const remember = prompt.match(/REMEMBER: (.+)/);
  if (remember) {
    const path = instructions.match(/memory file at (\S+)\./)[1];
    process.getBuiltinModule('node:fs').appendFileSync(path, `- ${remember[1]}\n`);
    return reply('Zapamiętane.');
  }
  const ask = prompt.match(/ASK (\w+): (.+)/);
  if (ask) return reply(`Odpowiedź od ${ask[1]}: ${await callMcpTool('ask_bot', { bot: ask[1], message: ask[2] })}`);
  if (prompt.startsWith('💬')) return reply(`Pong: ${prompt.split('\n').pop()}`);
  if (prompt.includes('SLEEP')) await sleep(30_000);
  out({ type: 'system', subtype: 'init', session_id: 'fake-session-1', model: 'sonnet' });
  out({ type: 'stream_event', event: { type: 'message_start' } });
  for (const w of words('Sprawdzę, co jest w katalogu roboczym. ')) {
    out({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text: w } } });
    await sleep(40);
  }
  out({ type: 'assistant', message: { id: 'm1', content: [{ type: 'tool_use', id: 'tu1', name: 'Bash', input: { command: 'ls -la /workspace', description: 'Lista plików w workspace' } }] } });
  await sleep(700);
  out({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: 'tu1', content: 'total 12\ndrwxr-xr-x 3 root root 4096 .\n-rw-r--r-- 1 root root  220 notatki.md\ndrwxr-xr-x 2 root root 4096 projekt' }] } });
  out({ type: 'assistant', message: { id: 'm2', content: [{ type: 'tool_use', id: 'tu2', name: 'Read', input: { file_path: '/workspace/notatki.md' } }] } });
  await sleep(500);
  out({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: 'tu2', content: '# Notatki\n- dokończyć POC' }] } });
  out({ type: 'stream_event', event: { type: 'message_start' } });
  const answer = `W \`/workspace\` są dwie rzeczy:\n\n| Nazwa | Typ |\n|---|---|\n| \`notatki.md\` | plik, 220 B |\n| \`projekt/\` | katalog |\n\nW notatkach jest jedno zadanie: **dokończyć POC**. (Pytanie: „${prompt.slice(0, 60)}”.)${instructions ? ` Instrukcje bota: ${instructions}` : ''}`;
  for (const w of words(answer)) {
    out({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text: w } } });
    await sleep(25);
  }
  out({ type: 'result', subtype: 'success', is_error: false, result: answer, session_id: 'fake-session-1', total_cost_usd: 0.0123, usage: { input_tokens: 1200, output_tokens: 86 } });
})();
